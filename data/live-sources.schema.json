{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kingway87/jerebu-exe/blob/main/data/live-sources.schema.json",
  "title": "JEREBU.EXE live evidence source registry",
  "description": "Machine-readable register of the public sources investigated for the live evidence page (Experiment 003): what each is, how it can be accessed, what it can and cannot show, and how its facts were checked. Every claim here was checked by AI agents opening official pages; none has yet been verified by a human (verification.humanVerified).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryUpdated",
    "about",
    "sources"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "registryUpdated": {
      "$ref": "#/$defs/date"
    },
    "about": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "institution",
        "jurisdiction",
        "category",
        "recordType",
        "officialUrl",
        "documentationUrls",
        "accessMethod",
        "authenticationRequired",
        "authentication",
        "updateFrequency",
        "status",
        "integration",
        "licence",
        "attribution",
        "freshness",
        "canShow",
        "cannotShow",
        "limitations",
        "verification"
      ],
      "properties": {
        "id": {
          "description": "Stable identifier, lower-case kebab-case. Observations reference it as sourceId.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "institution": {
          "description": "The body that produces the data.",
          "$ref": "#/$defs/nonEmptyString"
        },
        "publisher": {
          "description": "The body that publishes or distributes it, when different from the producer (for example a national open-data portal).",
          "$ref": "#/$defs/nonEmptyString"
        },
        "jurisdiction": {
          "enum": [
            "global",
            "regional",
            "malaysia",
            "singapore",
            "indonesia"
          ]
        },
        "category": {
          "enum": [
            "satellite-fire-observations",
            "air-quality",
            "meteorology",
            "regional-haze",
            "basemap"
          ]
        },
        "recordType": {
          "description": "What kind of record the source provides, on the evidence ladder's terms. 'observation': measured or recorded values. 'forecast': model or forecaster output about the future. 'assessment': an authority's reading of observations. 'reference': base data such as coastlines.",
          "enum": [
            "observation",
            "forecast",
            "assessment",
            "reference"
          ]
        },
        "officialUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "linkable": {
          "description": "False when the publisher's terms of use restrict other websites from linking to it without notice or permission. The site then names the source without a hyperlink. Defaults to true.",
          "type": "boolean"
        },
        "documentationUrls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/httpsUrl"
          }
        },
        "accessMethod": {
          "enum": [
            "rest-api",
            "file-download",
            "web-page",
            "mobile-app",
            "none-found"
          ]
        },
        "dataFormat": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "endpoints": {
          "description": "Documented endpoints. Credentials appear only as placeholders such as {MAP_KEY}.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "description"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "description": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "authenticationRequired": {
          "description": "True if a key, token or account is needed to retrieve the data used here.",
          "type": "boolean"
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "notes"
          ],
          "properties": {
            "type": {
              "enum": [
                "none",
                "api-key-optional",
                "api-key-required",
                "account-required",
                "unknown"
              ]
            },
            "envVar": {
              "description": "Server-side environment variable that holds the credential. Never prefixed NEXT_PUBLIC_.",
              "type": "string",
              "pattern": "^(?!NEXT_PUBLIC_)[A-Z][A-Z0-9_]*$"
            },
            "howToObtain": {
              "$ref": "#/$defs/httpsUrl"
            },
            "notes": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        "rateLimits": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "updateFrequency": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "latency": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "historicalAvailability": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "description": "Access status as defined in the Experiment 003 brief.",
          "enum": [
            "AVAILABLE",
            "PARTIALLY AVAILABLE",
            "MANUAL SOURCE",
            "REQUIRES ACCESS",
            "NOT YET VERIFIED"
          ]
        },
        "integration": {
          "description": "What this site does with the source. 'integrated': fetched by the site and displayed. 'integrated-needs-credential': the code exists and runs when the credential is configured. 'bundled': copied into the repository at development time and displayed; never fetched by the site. 'link-only': linked, not copied. 'reference-only': documented here, neither copied nor linked from the page.",
          "enum": [
            "integrated",
            "integrated-needs-credential",
            "bundled",
            "link-only",
            "reference-only"
          ]
        },
        "licence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "url": {
              "$ref": "#/$defs/httpsUrl"
            }
          }
        },
        "attribution": {
          "description": "The attribution text the source asks for, or how this site credits it.",
          "$ref": "#/$defs/nonEmptyString"
        },
        "freshness": {
          "description": "Freshness thresholds for integrated sources; null for sources this site does not fetch.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "basis",
                "recentMaxMinutes",
                "staleAfterMinutes",
                "rationale"
              ],
              "properties": {
                "basis": {
                  "enum": [
                    "observedAt",
                    "retrievedAt"
                  ]
                },
                "recentMaxMinutes": {
                  "type": "integer",
                  "minimum": 1
                },
                "staleAfterMinutes": {
                  "type": "integer",
                  "minimum": 2
                },
                "rationale": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            }
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "meaning"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "meaning": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "unit": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        },
        "canShow": {
          "$ref": "#/$defs/stringList"
        },
        "cannotShow": {
          "$ref": "#/$defs/stringList"
        },
        "limitations": {
          "$ref": "#/$defs/stringList"
        },
        "notUsedBecause": {
          "description": "For a source the page does not fetch or bundle: the reason, in one sentence, shown in the page's list of sources investigated but not used.",
          "$ref": "#/$defs/nonEmptyString"
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "checkedOn",
            "checkedBy",
            "method",
            "humanVerified",
            "evidence"
          ],
          "if": {
            "properties": {
              "humanVerified": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "humanVerification"
            ],
            "properties": {
              "humanVerification": {
                "type": "object"
              }
            }
          },
          "properties": {
            "checkedOn": {
              "$ref": "#/$defs/date"
            },
            "checkedBy": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "method": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "humanVerified": {
              "description": "True only when a named human has checked the entry against its sources and said so. An AI agent may record that human's attestation, at their instruction, but must never set this on its own judgement.",
              "type": "boolean"
            },
            "humanVerification": {
              "description": "Required when humanVerified is true.",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "by",
                "on",
                "notes"
              ],
              "properties": {
                "by": {
                  "$ref": "#/$defs/nonEmptyString"
                },
                "on": {
                  "$ref": "#/$defs/date"
                },
                "notes": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "claim",
                  "url",
                  "quote"
                ],
                "properties": {
                  "claim": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "url": {
                    "$ref": "#/$defs/httpsUrl"
                  },
                  "quote": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "archivedCopy": {
                    "description": "A copy in a public web archive. Where the live page refused automated requests, the copy that was actually read.",
                    "$ref": "#/$defs/httpsUrl"
                  }
                }
              }
            },
            "unverified": {
              "$ref": "#/$defs/stringList"
            }
          }
        }
      }
    }
  }
}
