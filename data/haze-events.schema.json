{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kingway87/jerebu-exe/blob/main/data/haze-events.schema.json",
  "title": "JEREBU.EXE haze history dataset",
  "description": "Transboundary haze episodes affecting Malaysia and Singapore, with legal and policy milestones. Every claim carries at least one source reference with the exact passage relied on. The website (src/content/haze-history.ts) also checks rules this schema cannot express: that every reference resolves to a source, that ids are unique, that each event lists exactly the sources it cites, that no source goes uncited, that each episode's selection criteria are shown by its own claims, that dates are real and not after the compilation date, that review stages are consistent and never recorded by an AI, and that no text field carries a company-style name.",
  "type": "object",
  "required": [
    "schemaVersion",
    "meta",
    "sources",
    "events",
    "milestones",
    "excluded"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "meta": {
      "type": "object",
      "required": [
        "title",
        "description",
        "experiment",
        "studyPeriod",
        "primaryJurisdictions",
        "selectionCriteria",
        "confidenceMethod",
        "compiledBy",
        "compiled",
        "review",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "experiment": {
          "type": "string",
          "pattern": "^\\d{3}$"
        },
        "studyPeriod": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            }
          }
        },
        "primaryJurisdictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jurisdiction"
          },
          "minItems": 1
        },
        "selectionCriteria": {
          "description": "The criteria every included episode had to meet, as written before the research results were read. An episode is included when A and at least one of B1, B2 or B3 are met.",
          "type": "object",
          "required": [
            "written",
            "note",
            "definitions"
          ],
          "additionalProperties": false,
          "properties": {
            "written": {
              "$ref": "#/$defs/day"
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "definitions": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "$ref": "#/$defs/criterion"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "confidenceMethod": {
          "description": "How each episode's confidence level was assigned, as written before the research results were read.",
          "type": "object",
          "required": [
            "written",
            "question",
            "note",
            "definitions"
          ],
          "additionalProperties": false,
          "properties": {
            "written": {
              "$ref": "#/$defs/day"
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            },
            "definitions": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "level",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "enum": [
                      "high",
                      "medium",
                      "low"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "compiledBy": {
          "type": "string",
          "minLength": 1
        },
        "compiled": {
          "$ref": "#/$defs/day"
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/milestone"
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/excluded"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "date": {
      "description": "YYYY, YYYY-MM or YYYY-MM-DD.",
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "day": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://\\S+$"
    },
    "jurisdiction": {
      "enum": [
        "MY",
        "SG",
        "ID",
        "BN",
        "TH",
        "PH",
        "ASEAN"
      ]
    },
    "criterion": {
      "enum": [
        "A",
        "B1",
        "B2",
        "B3"
      ]
    },
    "humanReview": {
      "type": "object",
      "required": [
        "by",
        "date"
      ],
      "additionalProperties": false,
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "$ref": "#/$defs/day"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "review": {
      "description": "Review stage. Each stage includes the ones before it. Only a named human can record human-checked or human-verified.",
      "type": "object",
      "required": [
        "stage",
        "humanChecked",
        "humanVerified"
      ],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "ai-generated",
            "source-attached",
            "human-checked",
            "human-verified"
          ]
        },
        "humanChecked": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/humanReview"
            }
          ]
        },
        "humanVerified": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/humanReview"
            }
          ]
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "required": [
        "source",
        "quote",
        "check"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/id"
        },
        "quote": {
          "description": "The exact passage relied on, copied from the source.",
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "pinpoint": {
          "description": "Page, section, paragraph or table.",
          "type": "string"
        },
        "language": {
          "description": "Language of the passage, where it differs from the source's (BCP 47 tag).",
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
        },
        "check": {
          "description": "verbatim: matched by script against the text downloaded from the source. not-machine-checked: read through a page-reading tool; not matched by script.",
          "enum": [
            "verbatim",
            "not-machine-checked"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "text",
        "label",
        "refs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "description": "Claim label, as defined in docs/METHODOLOGY.md section 3.",
          "enum": [
            "fact",
            "observation",
            "analysis",
            "allegation",
            "hypothesis",
            "legal-finding"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          },
          "minItems": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "publisher",
        "published",
        "url",
        "accessed",
        "accessMethod",
        "type",
        "language"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string"
        },
        "published": {
          "oneOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "const": "undated"
            }
          ]
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "archivedUrl": {
          "description": "An existing copy in a public web archive. Not compared with the text that was read.",
          "$ref": "#/$defs/url"
        },
        "readFrom": {
          "description": "The address actually read, if different from url.",
          "$ref": "#/$defs/url"
        },
        "accessed": {
          "$ref": "#/$defs/day"
        },
        "accessMethod": {
          "enum": [
            "downloaded",
            "web-fetch",
            "archive-downloaded",
            "archive-web-fetch"
          ]
        },
        "type": {
          "enum": [
            "government",
            "legal",
            "intergovernmental",
            "scientific-agency",
            "peer-reviewed",
            "news",
            "reference"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "access": {
          "enum": [
            "open",
            "paywalled",
            "partial"
          ]
        },
        "doi": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "countryRecord": {
      "type": "object",
      "required": [
        "impact",
        "airQuality",
        "responses"
      ],
      "additionalProperties": false,
      "properties": {
        "impact": {
          "$ref": "#/$defs/claims"
        },
        "airQuality": {
          "$ref": "#/$defs/claims"
        },
        "responses": {
          "$ref": "#/$defs/claims"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "title",
        "ongoing",
        "period",
        "jurisdictions",
        "summary",
        "malaysia",
        "singapore",
        "health",
        "regionalContext",
        "diplomaticResponse",
        "policyDevelopments",
        "legalDevelopments",
        "aftermath",
        "sources",
        "selection",
        "attribution",
        "confidence",
        "contradictions",
        "evidenceGaps",
        "unresolvedQuestions",
        "relatedMilestones",
        "review"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "ongoing": {
          "description": "True if the episode was still under way when the research was done. Its figures are provisional.",
          "type": "boolean"
        },
        "period": {
          "type": "object",
          "required": [
            "start",
            "end",
            "label",
            "refs"
          ],
          "additionalProperties": false,
          "properties": {
            "start": {
              "$ref": "#/$defs/date"
            },
            "end": {
              "$ref": "#/$defs/date"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "refs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/sourceRef"
              },
              "minItems": 1
            },
            "note": {
              "type": "string"
            }
          }
        },
        "jurisdictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jurisdiction"
          },
          "minItems": 1
        },
        "summary": {
          "allOf": [
            {
              "$ref": "#/$defs/claims"
            },
            {
              "type": "array",
              "minItems": 1
            }
          ]
        },
        "malaysia": {
          "$ref": "#/$defs/countryRecord"
        },
        "singapore": {
          "$ref": "#/$defs/countryRecord"
        },
        "health": {
          "$ref": "#/$defs/claims"
        },
        "regionalContext": {
          "$ref": "#/$defs/claims"
        },
        "diplomaticResponse": {
          "$ref": "#/$defs/claims"
        },
        "policyDevelopments": {
          "$ref": "#/$defs/claims"
        },
        "legalDevelopments": {
          "$ref": "#/$defs/claims"
        },
        "aftermath": {
          "$ref": "#/$defs/claims"
        },
        "sources": {
          "description": "Every source the event cites, in order of first use.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "selection": {
          "description": "Why the episode is included: each selection criterion met, with the ids of the claims in this event that show it. Must include A and at least one of B1, B2 or B3.",
          "type": "object",
          "required": [
            "criteria",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "criteria": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "criterion",
                  "claims"
                ],
                "additionalProperties": false,
                "properties": {
                  "criterion": {
                    "$ref": "#/$defs/criterion"
                  },
                  "claims": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/id"
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                }
              }
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "attribution": {
          "description": "origin: whether the bodies quoted agree on where the smoke came from (assessed) or publicly disagree (disputed). responsibility: this record does not establish who caused the fires; not-established is the only value accepted.",
          "type": "object",
          "required": [
            "origin",
            "responsibility",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "origin": {
              "enum": [
                "assessed",
                "disputed"
              ]
            },
            "responsibility": {
              "const": "not-established"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "confidence": {
          "type": "object",
          "required": [
            "level",
            "rationale"
          ],
          "additionalProperties": false,
          "properties": {
            "level": {
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "sources"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 2,
                "uniqueItems": true
              }
            }
          }
        },
        "evidenceGaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unresolvedQuestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "relatedMilestones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "milestone": {
      "type": "object",
      "required": [
        "id",
        "date",
        "kind",
        "group",
        "jurisdictions",
        "title",
        "claims",
        "relatedEvents",
        "review"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "kind": {
          "enum": [
            "regional-agreement",
            "ratification",
            "entry-into-force",
            "legislation",
            "policy",
            "institutional",
            "enforcement",
            "legal-outcome",
            "diplomatic",
            "measurement-change"
          ]
        },
        "group": {
          "description": "Which milestones page the entry belongs to: regional (ASEAN), a country, or changes to how air quality is measured.",
          "enum": [
            "regional",
            "singapore",
            "malaysia",
            "indonesia",
            "measurement"
          ]
        },
        "jurisdictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jurisdiction"
          },
          "minItems": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "allOf": [
            {
              "$ref": "#/$defs/claims"
            },
            {
              "type": "array",
              "minItems": 1
            }
          ]
        },
        "relatedEvents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "excluded": {
      "type": "object",
      "required": [
        "id",
        "period",
        "reason",
        "claims"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "$ref": "#/$defs/claims"
        }
      }
    }
  }
}
